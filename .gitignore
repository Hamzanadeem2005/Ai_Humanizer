# appsettings.json contains the real DB password and OpenRouter API key.
# The placeholder version (appsettings.json) is committed so the app can
# start with obvious dummy values, but any file with real secrets should
# be kept local. Use appsettings.Local.json or environment variables
# to override without committing credentials.
appsettings.Production.json
appsettings.Local.json
**/appsettings.Local.json
appsettings.Secret.json
secrets.json

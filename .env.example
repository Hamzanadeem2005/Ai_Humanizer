# ============================================================
# HumanizeAI — Environment Variable Template
# ============================================================
# Copy this file and fill in your real values.
# NEVER commit a file containing real secrets to version control.
#
# These values are currently hardcoded in the source files listed below.
# Move them to appsettings.json (and .gitignore that file) or use
# environment variables / a secrets manager before any public deployment.
# ============================================================

# ----------------------------------------------------------
# OpenRouter API Key
# Used in: Backeend/HumanizeAI_Project/Controllers/HumanizeController.cs
# Get your key at: https://openrouter.ai
# ----------------------------------------------------------
OPENROUTER_API_KEY=

# ----------------------------------------------------------
# MySQL Database Connection
# Used in: Backeend/HumanizeAI_Project/Services/DatabaseService.cs
# Default local dev values shown — change for your environment
# ----------------------------------------------------------
DB_SERVER=localhost
DB_NAME=humanizeai_db
DB_USER=root
DB_PASSWORD=
